# Copy to .env and fill in. Never commit the real .env file.

# "development" locally (the default), "production" in the hosting dashboard - gates
# startup checks (refusing to boot with the default JWT secret) and CORS/localhost
# behavior in main.py.
ENVIRONMENT=development

# LLM (Groq — free tier at console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Gemini - used as a second, independent model to cross-check Groq's answers
# (llm/gemini_client.py), NOT for embeddings (those are local now, see below).
GEMINI_API_KEY=

# Embeddings: local via fastembed (ONNX Runtime) - no key, no rate limit, no
# per-request cost. Default model name lives in config/settings.py's
# EMBEDDING_MODEL; override here only if you want a different fastembed model.
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Relational database. In production this is a Supabase Postgres connection
# string (Project Settings -> Database -> Connection string -> URI, psycopg2 scheme).
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/ethio_student_helper

# Same database as DATABASE_URL, on the psycopg3 driver langchain-postgres (the
# vector store) requires. Same Supabase connection string in production, just with
# +psycopg instead of +psycopg2.
VECTOR_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ethio_student_helper

# Supabase Storage (exam diagram photos, payment receipts) - Project Settings ->
# API -> Project URL / service_role key. Leave both empty for local dev: exams/store.py
# and routes_payments.py then read/write local disk directly instead (storage.py).
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# CORS - the deployed Vercel frontend's origin(s), comma-separated. Leave empty for
# local dev (localhost is always allowed regardless of this setting).
ALLOWED_ORIGINS=

# Auth — generate a real random secret for anything beyond local dev,
# e.g. `python -c "import secrets; print(secrets.token_hex(32))"`
JWT_SECRET_KEY=dev-only-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=20160

# Telegram bot - also read here (not just telegram_bot/config.py) so the backend
# can push a receipt-needs-review notification straight to an admin's Telegram chat.
TELEGRAM_BOT_TOKEN=

# Public links shown in the app (Profile and Help). The channel is the one every student is
# invited to; the subscriber-only group is TELEGRAM_PRIVATE_GROUP_URL. The bot reads the same names.
# TELEGRAM_CHANNEL_URL=https://t.me/ethio_student_helper
# TELEGRAM_BOT_URL=https://t.me/esh_bot

# Price and payment accounts. The web app and the bot read them from the backend, so set them on the
# backend only. A new referral reward applies to later referrals; earlier ones keep what they earned.
# SUBSCRIPTION_PRICE_ETB=300
# PAYMENT_TELEBIRR_NUMBER=0909575318
# PAYMENT_CBE_ACCOUNT=1000198942948
# REFERRAL_REWARD_ETB=50

# Shared secret for the bot's calls that are not on behalf of one student (creating today's
# mass-practice challenge, checking a join request). The bot reads the same value from this
# file. Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
BOT_INTERNAL_TOKEN=dev-only-change-me

# Daily mass ESSLCE practice, in a subscriber-only Telegram group (telegram_bot/mass_challenge.py).
# 0 turns the whole feature off. The id is negative: add the bot to the group as an admin with
# "approve new members" on, send a message, and read chat.id from the bot's getUpdates.
TELEGRAM_PRIVATE_GROUP_ID=0
# That group's invite link, shown on the Profile page to subscribed students only.
TELEGRAM_PRIVATE_GROUP_URL=
# The group has Topics enabled: one thread per stream (a thread id, read the same way as above).
# A common-subject day (English/SAT/Maths) posts to the natural topic.
MASS_CHALLENGE_NATURAL_TOPIC_ID=
MASS_CHALLENGE_SOCIAL_TOPIC_ID=
MASS_CHALLENGE_TIME=20:00             # local time (BOT_TIMEZONE, default Africa/Addis_Ababa)
MASS_CHALLENGE_HEADSUP_MINUTES=10     # one heads-up message this long before it starts
MASS_CHALLENGE_NUDGE_MINUTES=60       # private streak reminder this long after it starts
MASS_CHALLENGE_QUESTION_COUNT=6
MASS_CHALLENGE_QUESTION_SECONDS=90    # each poll's open time
WEEKLY_REPORT_TIME=18:00              # Sunday, local time: each student's weekly summary
# WEB_APP_URL=https://ethio-student-helper.vercel.app   # backend: links in the channel posts

# Regular posts to the public channel (telegram_bot/channel_posts.py). The bot must be an admin of
# the channel with "Post messages". The channel is taken from TELEGRAM_CHANNEL_URL unless set here.
# CHANNEL_CHAT_ID=@ethio_student_helper
CHANNEL_POSTS=on                      # off to stop all channel posts
CHANNEL_POST_TIME=19:00               # daily quiz, local time
CHANNEL_FEATURE_DAYS=tue,thu,sat      # a feature post follows the quiz on these days

# Bot only (telegram_bot/config.py and store.py):
# BACKEND_BASE_URL=http://localhost:8000
# BOT_DATA_DIR=./telegram_bot/data    # login sessions and reminders (state.json); a volume in production

# Error monitoring (Sentry free tier at sentry.io) - optional; main.py only
# initializes Sentry if this is set, so local dev needs nothing here.
SENTRY_DSN=
