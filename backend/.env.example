# Copy to .env and fill in. Never commit the real .env file.

# LLM (Groq — free tier at console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Embeddings (Gemini — free tier at aistudio.google.com; Groq doesn't
# serve embedding models, so this is a separate provider from the LLM)
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

# Relational database. In production this is a Supabase Postgres connection
# string (Project Settings -> Database -> Connection string -> URI, psycopg2 scheme).
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/ethio_student_helper

# Same database as DATABASE_URL, on the psycopg3 driver langchain-postgres (the
# vector store) requires. Same Supabase connection string in production, just with
# +psycopg instead of +psycopg2.
VECTOR_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ethio_student_helper

# Supabase Storage (exam diagram photos, payment receipts) - Project Settings ->
# API -> Project URL / service_role key. Leave both empty for local dev: exams/store.py
# and routes_payments.py then read/write local disk directly instead (storage.py).
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# CORS - the deployed Vercel frontend's origin(s), comma-separated. Leave empty for
# local dev (localhost is always allowed regardless of this setting).
ALLOWED_ORIGINS=

# Auth — generate a real random secret for anything beyond local dev,
# e.g. `python -c "import secrets; print(secrets.token_hex(32))"`
JWT_SECRET_KEY=dev-only-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=20160

# Telegram bot - also read here (not just telegram_bot/config.py) so the backend
# can push a receipt-needs-review notification straight to an admin's Telegram chat.
TELEGRAM_BOT_TOKEN=
